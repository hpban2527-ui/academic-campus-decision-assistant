{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-e/activity.schema.json",
  "title": "Project E validated activity; publish only after reviewer approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activity_id",
    "source",
    "title",
    "domain",
    "start",
    "end",
    "registration_deadline",
    "mode",
    "location",
    "points",
    "mandatory",
    "audience",
    "fee",
    "completion_requirements"
  ],
  "properties": {
    "activity_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "platform",
        "URL_post",
        "URL_registration"
      ],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "URL_post": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "URL_registration": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "academic",
            "volunteer",
            "culture_sports",
            "skills",
            "career",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "start": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "end": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "registration_deadline": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "hybrid"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "points": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "mandatory": {
      "type": "boolean"
    },
    "audience": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "fee": {
      "type": "number",
      "minimum": 0
    },
    "completion_requirements": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "online"
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "type": "null"
          }
        }
      }
    }
  ]
}
