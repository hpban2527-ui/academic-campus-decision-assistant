{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extraction_draft.schema.json",
  "title": "Extraction draft (SP1 extractor output)",
  "description": "What extract(text, source) returns: a JSON array of drafts, one per activity found in the announcement. Each draft = record (activity fields, relaxed: the four required fields may be null) + meta (set by deterministic code, never by the model). The validator routes drafts: status valid -> deduplicator -> activities.json; partial or failed -> review_queue.json. The record block must stay in sync with activity.schema.json (see the open questions in the ADR). See docs/adr/0001-sp1-extraction-contract.md.",
  "x-schema-version": "1.3.0",
  "type": "array",
  "items": {
    "$ref": "#/$defs/draft"
  },
  "$defs": {
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "meta"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/draft_record"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    },
    "draft_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "source",
        "title",
        "domain",
        "start",
        "end",
        "registration_deadline",
        "mode",
        "location",
        "points",
        "drl_recognized",
        "mandatory",
        "audience",
        "fee",
        "completion_requirements"
      ],
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "online"
          }
        }
      },
      "then": {
        "description": "Invariant (ADR 0001, D13): an online activity has no physical location.",
        "properties": {
          "location": {
            "type": "null"
          }
        }
      },
      "properties": {
        "activity_id": {
          "description": "Temporary ID: TMP-<first 8 hex of sha1(URL_post)>-<2-digit index of the activity in the announcement>. Deterministic: same input gives same ID.",
          "type": "string",
          "pattern": "^TMP-[0-9a-f]{8}-[0-9]{2}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publisher",
            "platform",
            "URL_post",
            "URL_registration"
          ],
          "properties": {
            "publisher": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "URL_post": {
              "type": "string",
              "format": "uri"
            },
            "URL_registration": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            }
          }
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "domain": {
          "enum": [
            "academic",
            "volunteer",
            "culture_sports",
            "skills",
            "career",
            "other",
            null
          ]
        },
        "start": {
          "$ref": "#/$defs/datetime_or_null"
        },
        "end": {
          "$ref": "#/$defs/datetime_or_null"
        },
        "registration_deadline": {
          "$ref": "#/$defs/datetime_or_null"
        },
        "mode": {
          "enum": [
            "online",
            "offline",
            "hybrid",
            null
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "points": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "drl_recognized": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mandatory": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "audience": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "fee": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "completion_requirements": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "flags",
        "evidence",
        "time_defaults",
        "year_from_posted",
        "derived",
        "method",
        "model",
        "fallback_from",
        "draft_schema_version"
      ],
      "properties": {
        "status": {
          "description": "valid: no flags. partial: only needs_review flags. failed: any other flag.",
          "enum": [
            "valid",
            "partial",
            "failed"
          ]
        },
        "flags": {
          "description": "needs_review:<field> = title or mode is not stated, or completion_requirements is not stated for an online activity that counts for conduct score (ADR 0001, D16). ungrounded:<field> = value has no matching evidence span in the text, or the evidence does not state the value (drl_recognized, mandatory, fee, completion_requirements: value set to null). out_of_range:<field>, invalid_value:<field>, end_before_start, parse_error, injection_suspected.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^((needs_review|ungrounded|out_of_range|invalid_value):[A-Za-z_]+|end_before_start|parse_error|injection_suspected)$"
          }
        },
        "evidence": {
          "description": "Field name -> exact span (or list of spans) copied from the announcement text. Every non-null extracted field except activity_id and source needs one; the grounding check verifies each span occurs in the text (after Unicode NFC and whitespace normalisation).",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            ]
          }
        },
        "time_defaults": {
          "description": "Which datetime fields got a default time because the text gave only a date.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "const": "date_only_0000"
            },
            "end": {
              "const": "date_only_2359"
            },
            "registration_deadline": {
              "const": "date_only_2359"
            }
          }
        },
        "year_from_posted": {
          "description": "Datetime fields whose year was not in the text and was taken from the posting date (posted year, or next year if the date would fall over 60 days before the post).",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "start",
              "end",
              "registration_deadline"
            ]
          }
        },
        "derived": {
          "description": "Values set by the mode/location reconciliation (ADR 0001, D13), not read directly from the text. mode: why mode was derived (a physical venue, an online platform as venue, or a meeting link). location: the location was cleared because the activity is online.",
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "mode": {
              "enum": [
                "venue_physical",
                "venue_platform",
                "meeting_link"
              ]
            },
            "location": {
              "const": "cleared_for_online"
            }
          }
        },
        "method": {
          "enum": [
            "llm",
            "regex"
          ]
        },
        "model": {
          "description": "Model id and prompt version when method = llm, e.g. 'qwen-4b-4bit/prompt_v1'. null for regex.",
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_from": {
          "description": "Set when the LLM path failed and the regex baseline produced this draft instead.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^llm:(parse_error|client_error)$"
        },
        "draft_schema_version": {
          "const": "1.3.0"
        }
      }
    },
    "datetime_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+07:00$"
    }
  }
}
