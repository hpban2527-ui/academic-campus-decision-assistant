{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer_a_record_v2.schema.json",
  "title": "SP1 layer A stated facts",
  "x-schema-version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record",
    "year_inferred",
    "flags",
    "evidence"
  ],
  "properties": {
    "record": {
      "$ref": "#/$defs/record"
    },
    "year_inferred": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_type",
        "title",
        "domain",
        "multi_session",
        "window_open",
        "window_close",
        "duration_minutes_stated",
        "registration_deadline",
        "mode",
        "location",
        "audience_text",
        "audience_scope",
        "mandatory_stated",
        "recognition_stated",
        "points_stated",
        "fee",
        "registration_url",
        "join_url",
        "completion_requirements"
      ],
      "properties": {
        "post_type": {
          "enum": [
            "activity",
            "info_only",
            "insufficient",
            null
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "domain": {
          "enum": [
            "academic",
            "volunteer",
            "culture_sports",
            "skills",
            "career",
            "other",
            null
          ]
        },
        "multi_session": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "window_open": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?:T(?:[01][0-9]|2[0-3]):[0-5][0-9]\\+07:00)?$"
        },
        "window_close": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?:T(?:[01][0-9]|2[0-3]):[0-5][0-9]\\+07:00)?$"
        },
        "duration_minutes_stated": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "registration_deadline": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?:T(?:[01][0-9]|2[0-3]):[0-5][0-9]\\+07:00)?$"
        },
        "mode": {
          "enum": [
            "online",
            "offline",
            "hybrid",
            null
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "audience_text": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "audience_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cohorts",
            "programs"
          ],
          "properties": {
            "cohorts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^K[0-9]{2}$"
              },
              "uniqueItems": true
            },
            "programs": {
              "type": "array",
              "items": {
                "enum": [
                  "standard",
                  "high_quality"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "mandatory_stated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "recognition_stated": {
          "enum": [
            true,
            null
          ]
        },
        "points_stated": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fee": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "const": 0
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount_vnd",
                "per",
                "deposit"
              ],
              "properties": {
                "amount_vnd": {
                  "type": "integer",
                  "minimum": 0
                },
                "per": {
                  "enum": [
                    "person",
                    "team",
                    "unknown"
                  ]
                },
                "deposit": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "registration_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "join_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "completion_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "threshold",
              "unit",
              "deadline"
            ],
            "properties": {
              "type": {
                "enum": [
                  "check_in",
                  "check_out",
                  "quiz",
                  "form",
                  "proof_upload",
                  "min_duration",
                  "other"
                ]
              },
              "threshold": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "deadline": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?:T(?:[01][0-9]|2[0-3]):[0-5][0-9]\\+07:00)?$"
              }
            }
          }
        }
      }
    }
  }
}
